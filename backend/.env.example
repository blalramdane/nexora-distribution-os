APP_NAME="NEXORA Distribution OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexora_distribution
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=local

# Transactional outbox. Local preview safely logs event metadata; webhook delivery
# must be explicitly enabled with a trusted HTTPS URL and a strong signing secret.
NEXORA_OUTBOX_CHANNEL=log
NEXORA_OUTBOX_DESTINATION=nexora-domain-events
NEXORA_OUTBOX_WEBHOOK_URL=
NEXORA_OUTBOX_WEBHOOK_SECRET=
NEXORA_OUTBOX_MAX_ATTEMPTS=8
NEXORA_OUTBOX_LEASE_SECONDS=300
NEXORA_OUTBOX_RETRY_BASE_SECONDS=15
NEXORA_OUTBOX_RETRY_MAX_SECONDS=3600
