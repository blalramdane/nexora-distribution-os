# Copy this file to the repository root as .env and fill every required value.
# Do not reuse credentials from the local SQLite development app or another project.
APP_ENV=local
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8081
LOG_LEVEL=info

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=nexora_distribution
MYSQL_USER=nexora_app
MYSQL_PASSWORD=

# These defaults avoid the local NEXORA API (8017) and another project's 8000 port.
API_HOST_PORT=8081
FRONTEND_HOST_PORT=3001
MYSQL_HOST_PORT=3307
NEXT_PUBLIC_API_URL=/api/v1
